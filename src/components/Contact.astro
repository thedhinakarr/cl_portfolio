---
---

<section class="contact section" id="contact">
  <div class="container contact-container">
    <div class="marker">
      <span class="num">05</span>
      <span class="marker-dot"></span>
      <span>The ask</span>
    </div>

    <h2 class="display contact-heading">
      Let's talk <em>carbon</em>.
    </h2>

    <a href="mailto:abhinav@carbonlens.app" class="contact-email">
      abhinav@carbonlens.app
    </a>

    <div class="contact-socials">
      <a href="https://github.com/abhinavannareddy" class="contact-pill" target="_blank" rel="noopener noreferrer">
        <i class="ph-bold ph-github-logo" style="font-size: 16px;"></i>
        GitHub
      </a>
      <a href="https://linkedin.com/in/abhinavannareddy" class="contact-pill" target="_blank" rel="noopener noreferrer">
        <i class="ph-bold ph-linkedin-logo" style="font-size: 16px;"></i>
        LinkedIn
      </a>
      <a href="https://carbonlens.app" class="contact-pill" target="_blank" rel="noopener noreferrer">
        <i class="ph-bold ph-arrow-up-right" style="font-size: 16px;"></i>
        Live demo
      </a>
    </div>
  </div>
</section>

<style>
  .contact-container {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .contact-heading {
    font-size: clamp(64px, 10vw, 168px);
    line-height: 0.92;
    margin-bottom: clamp(32px, 4vw, 48px);
  }

  .contact-email {
    font-family: var(--font-mono);
    font-size: var(--fs-md);
    font-weight: 400;
    letter-spacing: var(--tracking-mono);
    color: var(--foreground);
    text-decoration: underline;
    text-decoration-color: var(--primary);
    text-underline-offset: 6px;
    text-decoration-thickness: 2px;
    transition: color 200ms ease;
    margin-bottom: 40px;
  }

  .contact-email:hover {
    color: var(--primary);
  }

  .contact-socials {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .contact-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    font-weight: 500;
    letter-spacing: var(--tracking-mono);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    color: var(--foreground);
    transition: background 200ms ease, color 200ms ease;
  }

  .contact-pill:hover {
    background: var(--foreground);
    color: var(--background);
  }
</style>
