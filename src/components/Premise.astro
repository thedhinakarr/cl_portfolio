    padding: 0;
    margin: 0 0 clamp(40px, 5vw, 64px) 0;
    max-width: 20ch;
  }

  .premise-attribution {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .premise-rule {
    width: 40px;
    height: 1px;
