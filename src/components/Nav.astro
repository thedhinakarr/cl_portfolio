---
import LeafMark from './LeafMark.astro';
---

<nav class="nav">
  <div class="nav-inner">
    <a href="/" class="nav-brand" aria-label="Home">
      <LeafMark size="sm" />
    </a>
    <div class="nav-links">
      <a href="#about" class="nav-link">About</a>
      <a href="https://carbonlenz.com" class="nav-link nav-link-cta" target="_blank" rel="noopener noreferrer">
        Demo <i class="ph-bold ph-arrow-up-right" style="font-size: 12px;"></i>
      </a>
    </div>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    mix-blend-mode: difference;
    padding: 20px 0;
  }

  .nav-inner {
    max-width: 1320px;
    margin-inline: auto;
    padding-inline: clamp(20px, 5vw, 64px);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-brand {
    display: inline-flex;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .nav-link {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    font-weight: 500;
    letter-spacing: var(--tracking-mono);
    color: var(--foreground);
    transition: opacity 200ms ease;
  }

  .nav-link:hover {
    opacity: 0.7;
  }

  .nav-link-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  @media (max-width: 480px) {
    .nav-links {
      gap: 20px;
    }
    .nav-link {
      font-size: var(--fs-xs);
    }
  }
</style>
