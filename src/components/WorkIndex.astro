---
import { work } from '../content/work';
---

<section class="work-index section" id="work">
  <div class="container">
    <div class="marker">
      <span class="num">03</span>
      <span class="marker-dot"></span>
      <span>Selected work</span>
    </div>

    <h2 class="display work-index-heading">
      An <em>index</em> of work.
    </h2>

    <div class="work-list">
      {work.map((entry) => {
        const Tag = entry.href ? 'a' : 'div';
        return (
          <Tag
            class={`work-row ${entry.active ? 'work-row-active' : ''}`}
            {...(entry.href ? { href: entry.href, target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            <span class="work-year num">{entry.year}</span>
            <div class="work-info">
              <span class="work-title">{entry.title}</span>
              <span class="work-role">{entry.role}</span>
            </div>
            <div class="work-tags hide-mobile">
              {entry.tags.map((tag) => (
                <span class="pill">{tag}</span>
              ))}
            </div>
            <span class={`work-status micro ${entry.active ? 'accent' : ''}`}>{entry.status}</span>
            <span class="work-arrow arrow hide-mobile">
              <i class="ph ph-arrow-up-right" style="font-size: 18px;"></i>
            </span>
          </Tag>
        );
      })}
    </div>
  </div>
</section>

<style>
  .work-index-heading {
    font-size: clamp(64px, 10vw, 144px);
    line-height: 0.92;
    margin-bottom: clamp(48px, 6vw, 80px);
  }

  .work-list {
    display: flex;
    flex-direction: column;
  }

  .work-row {
    display: grid;
    grid-template-columns: 80px 1fr 240px 100px 32px;
    align-items: start;
    gap: 16px;
    padding: 20px 0;
    border-top: 1px solid var(--border);
    transition: padding 200ms ease;
    text-decoration: none;
    color: inherit;
  }

  .work-row:last-child {
    border-bottom: 1px solid var(--border);
  }

  .work-row:hover {
    padding-left: 16px;
  }

  .work-row .arrow {
    transition: transform 200ms ease, opacity 200ms ease;
    opacity: 0.3;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 2px;
  }

  .work-row:hover .arrow {
    transform: translate(4px, -4px);
    opacity: 1;
  }

  .work-year {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    font-weight: 400;
    color: var(--muted-foreground);
    padding-top: 2px;
  }

  .work-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .work-title {
    font-family: var(--font-mono);
    font-size: var(--fs-base);
    font-weight: 600;
    letter-spacing: var(--tracking-mono);
  }

  .work-role {
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    color: var(--muted-foreground);
    line-height: 1.5;
  }

  .work-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding-top: 2px;
  }

  .work-status {
    padding-top: 4px;
    text-align: right;
  }

  .work-row-active .work-title {
    color: var(--primary);
  }

  @media (max-width: 768px) {
    .work-row {
      grid-template-columns: 60px 1fr auto;
    }
    .work-arrow,
    .work-tags {
      display: none;
    }
  }
</style>
