---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'CarbonLenz — AI CBAM Evidence Scanner',
  description = 'CarbonLenz — AI CBAM Evidence Scanner. Turns messy supplier emissions evidence into EU CBAM cost, risk, and supplier action.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- OG -->
    <meta property="og:title" content="CarbonLenz — AI CBAM Evidence Scanner" />
    <meta property="og:description" content="CarbonLenz turns supplier emissions evidence into EU CBAM cost, risk, and supplier action." />
    <meta property="og:image" content="/og.png" />
    <meta property="og:url" content="https://carbonlenz.com" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="CarbonLenz — AI CBAM Evidence Scanner" />
    <meta name="twitter:description" content="CarbonLenz turns supplier emissions evidence into EU CBAM cost, risk, and supplier action." />
    <meta name="twitter:image" content="/og.png" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Font preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Phosphor Icons -->
    <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css" />
    <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/fill/style.css" />
    <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/bold/style.css" />

    <!-- Styles -->
    <style is:global>
      @import '../styles/tokens.css';
      @import '../styles/global.css';
      @import '../styles/animations.css';
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
